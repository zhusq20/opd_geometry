#!/usr/bin/env bash
# Copy to local/mopd.env, assign one 96GB training GPU and one 48GB inference GPU, then source it.

_MOPD_EXAMPLE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
_MOPD_SLIME_ROOT="$(cd -- "${_MOPD_EXAMPLE_DIR}/../.." && pwd)"

export MOPD_ASSET_ROOT="${MOPD_ASSET_ROOT:-${_MOPD_SLIME_ROOT}/local/mopd_assets}"
export MOPD_MODEL_REPO="${MOPD_MODEL_REPO:-zsqzz/mopd-gpas-64k-models}"
export MOPD_MODEL_REVISION="${MOPD_MODEL_REVISION:-46c307ad13f274d8db7c1df949e4df8359ae6b32}"
export MOPD_DATA_REPO="${MOPD_DATA_REPO:-zsqzz/mopd-gpas-64k-data}"
export MOPD_DATA_REVISION="${MOPD_DATA_REVISION:-e3ead6f98b7089e0def39516cd06cf711b10b1ec}"
export MOPD_STUDENT_REVISION="ea980cb0a6c2ae4b936e82123acc929f1cec04c1"

export MOPD_HF_CHECKPOINT="${MOPD_ASSET_ROOT}/models/qwen3-1.7b-base"
export MOPD_BASE_MEGATRON="${MOPD_ASSET_ROOT}/models/qwen3-1.7b-base_torch_dist"
export MOPD_TEACHER_HF_ROOT="${MOPD_ASSET_ROOT}/models/teachers_hf"
export MOPD_TEACHER_BASE_HF="${MOPD_ASSET_ROOT}/models/student_hf"
export MOPD_DATA_ROOT="${MOPD_ASSET_ROOT}/data/m2rl"

export MOPD_GENERATED_DIR="${_MOPD_SLIME_ROOT}/local/mopd_no_think_generated"
export MOPD_OUTPUT_ROOT="${_MOPD_SLIME_ROOT}/outputs/mopd_no_think"
export MOPD_PACKAGE_DIR="${_MOPD_SLIME_ROOT}/outputs/mopd_no_think_packages"
export MOPD_TEACHER_SERVER_DIR="${_MOPD_SLIME_ROOT}/local/mopd_teacher_servers"

export MEGATRON_PATH="${MEGATRON_PATH:-/root/Megatron-LM}"
export MOPD_TRAIN_GPU="${MOPD_TRAIN_GPU:-0}"
export MOPD_INFERENCE_GPU="${MOPD_INFERENCE_GPU:-1}"
export MOPD_TEACHER_MATH_PORT="${MOPD_TEACHER_MATH_PORT:-31001}"
export MOPD_TEACHER_CODE_PORT="${MOPD_TEACHER_CODE_PORT:-31002}"
export MOPD_TEACHER_IF_PORT="${MOPD_TEACHER_IF_PORT:-31003}"
export MOPD_TEACHER_SCIENCE_PORT="${MOPD_TEACHER_SCIENCE_PORT:-31004}"
export CAPABILITY_CUDA_VISIBLE_DEVICES="${CAPABILITY_CUDA_VISIBLE_DEVICES:-0}"

export USE_WANDB="${USE_WANDB:-1}"
export WANDB_ENTITY="${WANDB_ENTITY:-zsqzz}"
export WANDB_PROJECT="${WANDB_PROJECT:-iclr2027-mopd-gpas-core}"

unset _MOPD_EXAMPLE_DIR _MOPD_SLIME_ROOT
