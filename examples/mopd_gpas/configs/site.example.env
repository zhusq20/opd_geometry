#!/usr/bin/env bash
# Copy this file to local/mopd.env, edit the site-specific values, then source it.

_MOPD_EXAMPLE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
_MOPD_SLIME_ROOT="$(cd -- "${_MOPD_EXAMPLE_DIR}/../.." && pwd)"

export MOPD_ASSET_ROOT="${MOPD_ASSET_ROOT:-${_MOPD_SLIME_ROOT}/local/mopd_assets}"
export MOPD_MODEL_REPO="${MOPD_MODEL_REPO:-zsqzz/mopd-gpas-64k-models}"
export MOPD_MODEL_REVISION="${MOPD_MODEL_REVISION:-46c307ad13f274d8db7c1df949e4df8359ae6b32}"
export MOPD_DATA_REPO="${MOPD_DATA_REPO:-zsqzz/mopd-gpas-64k-data}"
export MOPD_DATA_REVISION="${MOPD_DATA_REVISION:-e3ead6f98b7089e0def39516cd06cf711b10b1ec}"
export MOPD_HF_CHECKPOINT="${MOPD_ASSET_ROOT}/models/student_hf"
export MOPD_BASE_MEGATRON="${MOPD_ASSET_ROOT}/models/student_megatron"
export MOPD_TEACHER_HF_ROOT="${MOPD_ASSET_ROOT}/models/teachers_hf"
export MOPD_WARM_DIR="${MOPD_ASSET_ROOT}/models/warm_start-seed42"
export MOPD_DATA_ROOT="${MOPD_ASSET_ROOT}/data/m2rl"
export MOPD_CONTROLLED_RESULTS_ROOT="${MOPD_ASSET_ROOT}/data/frozen/controlled"

export MOPD_GENERATED_DIR="${_MOPD_SLIME_ROOT}/local/mopd_generated"
export MOPD_OUTPUT_ROOT="${_MOPD_SLIME_ROOT}/outputs/mopd_gpas_64k_v3"
export MOPD_PACKAGE_DIR="${_MOPD_SLIME_ROOT}/outputs/mopd_packages_64k_v3"
export MOPD_TEACHER_SLOT_STATE="${_MOPD_SLIME_ROOT}/local/mopd_teacher_slot/state.json"

export MEGATRON_PATH="${MEGATRON_PATH:-/root/Megatron-LM}"
export MOPD_TRAIN_CUDA_VISIBLE_DEVICES="${MOPD_TRAIN_CUDA_VISIBLE_DEVICES:-0}"
export MOPD_TEACHER_GPU="${MOPD_TEACHER_GPU:-1}"
export MOPD_TEACHER_PORT="${MOPD_TEACHER_PORT:-31001}"
export CAPABILITY_CUDA_VISIBLE_DEVICES="${CAPABILITY_CUDA_VISIBLE_DEVICES:-0}"

export USE_WANDB="${USE_WANDB:-1}"
export WANDB_ENTITY="${WANDB_ENTITY:-zsqzz}"
export WANDB_PROJECT="${WANDB_PROJECT:-iclr2027-mopd-gpas-64k}"

unset _MOPD_EXAMPLE_DIR _MOPD_SLIME_ROOT
