# Source from the repository root in a fresh shell. All IDs are physical GPU IDs.
export MOPD_PROFILE=smollm3
source examples/mopd_gpas/configs/smollm3.env

# Six 48GB GPUs: two learner shards, one rollout engine, three RL teachers.
export MOPD_TRAIN_GPUS=0,1
export MOPD_INFERENCE_GPU=2
export MOPD_TEACHER_MATH_GPU=3
export MOPD_TEACHER_CODE_GPU=4
export MOPD_TEACHER_IF_GPU=5
export MOPD_PAPER_MEASUREMENTS=0
# For one 80/96GB learner, instead use MOPD_TRAIN_GPUS=0 and optionally
# MOPD_PAPER_MEASUREMENTS=1 (the full geometry snapshots need extra disk/RAM).
export MOPD_TEACHER_MATH_PORT=32101
export MOPD_TEACHER_CODE_PORT=32102
export MOPD_TEACHER_IF_PORT=32103
export TEACHER_3B_MEM_FRACTION=0.65
export SGLANG_MEM_FRACTION=0.65
export MOPD_SGLANG_ATTENTION_BACKEND=flashinfer
# A6000's 99KiB shared-memory limit is too small for SGLang's deterministic
# FP32 BMM used by SmolLM3 RoPE. Retain per-request seeds with PyTorch sampling.
export MOPD_DETERMINISTIC_INFERENCE=0

# Dedicated A6000 hosts with unreliable PCIe P2P may require this transport flag.
export NCCL_P2P_DISABLE=1
export MEGATRON_PATH="${MEGATRON_PATH:-/root/Megatron-LM}"
export PYTHONPATH="${PWD}:${MEGATRON_PATH}${PYTHONPATH:+:${PYTHONPATH}}"
export USE_WANDB=0
export MOPD_OBSERVE_TASK_REWARDS=0
export MOPD_EVAL_DURING_TRAINING=0
